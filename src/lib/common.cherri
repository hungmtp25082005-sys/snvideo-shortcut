// Normalize and validate the selected input URL in the caller's flow.

@trimmedURL = trimWhitespace(@selectedURL)
@cleanURL = replaceText("#.*$", "", @trimmedURL, true, true)
@cleanSchemeValue = getURLDetail(@cleanURL, "Scheme")
@cleanHostValue = getURLDetail(@cleanURL, "Host")
@cleanScheme = lowercase("{@cleanSchemeValue}")
@cleanHost = lowercase("{@cleanHostValue}")

if @cleanScheme != "https" || !@cleanHost {
    alert("SNVideo chỉ chấp nhận URL HTTPS hợp lệ.", "SNVideo")
    stop()
}
