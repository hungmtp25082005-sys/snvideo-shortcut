// Audio is saved through the Files picker, never to Photos.

function saveAudio(text audioURL, text mediaID) {
    @validAudioURL = isHTTPSURL(@audioURL)

    if @validAudioURL != "1" {
        alert("Không tìm thấy URL âm thanh HTTPS hợp lệ.", "SNVideo")
        stop()
    }

    @audioFile = downloadURL(@audioURL)
    @audioName = "SNVideo_audio"

    if @mediaID {
        @audioName = "SNVideo_{@mediaID}_audio"
    }

    @namedAudio = setName(@audioFile, @audioName, false)
    saveFilePrompt(@namedAudio, false)
    showNotification("Đã chuyển âm thanh tới trình lưu tệp.", "SNVideo")
}
