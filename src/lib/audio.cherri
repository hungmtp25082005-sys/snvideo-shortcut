// Save the selected audio through Files, never Photos.

@validAudioURL = false
if @audioURL {
    @audioSchemeValue = getURLDetail(@audioURL, "Scheme")
    @audioHostValue = getURLDetail(@audioURL, "Host")
    @audioScheme = lowercase("{@audioSchemeValue}")
    @audioHost = lowercase("{@audioHostValue}")
    if @audioScheme == "https" && @audioHost {
        @validAudioURL = true
    }
}

if @validAudioURL != true {
    alert("Không tìm thấy URL âm thanh HTTPS hợp lệ.", "SNVideo")
    stop()
}

@audioFile = downloadURL(@audioURL)
@audioName = "SNVideo_audio"
if @mediaID {
    @audioName = "SNVideo_{@mediaID}_audio"
}

@namedAudio = setName(@audioFile, @audioName)
saveFilePrompt(@namedAudio)
showNotification("Đã chuyển âm thanh tới trình lưu tệp.", "SNVideo")
