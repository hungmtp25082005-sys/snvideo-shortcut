// TikTok video selection and sequential download/save pipeline.

function downloadAndSaveVideo(text mediaURL, text resultLabel) {
    @validMediaURL = isHTTPSURL(@mediaURL)

    if @validMediaURL != "1" {
        alert("TikWM không trả về URL video HTTPS hợp lệ.", "SNVideo")
        stop()
    }

    @videoFile = downloadURL(@mediaURL)
    savePhoto(@videoFile)
    showNotification(@resultLabel, "SNVideo")
}

function chooseAndSaveVideo(dictionary data, bool audioEnabled) {
    @hdValue = @data['hdplay']
    @sdValue = @data['play']
    @audioValue = @data['music']
    @mediaIDValue = @data['id']
    @hdURL = "{@hdValue}"
    @sdURL = "{@sdValue}"
    @audioURL = "{@audioValue}"
    @mediaID = "{@mediaIDValue}"
    @audioValid = isHTTPSURL(@audioURL)

    if @audioEnabled == true && @audioValid == "1" {
        menu "Bạn muốn tải nội dung nào?" {
            item "Video chất lượng cao":
                if @hdURL {
                    downloadAndSaveVideo(@hdURL, "Đã lưu video HD vào Ảnh.")
                } else {
                    if @sdURL {
                        downloadAndSaveVideo(@sdURL, "Đã lưu video bằng chất lượng khả dụng.")
                    } else {
                        alert("TikWM không trả về video HD hoặc SD.", "SNVideo")
                        stop()
                    }
                }
            item "Video tải nhanh":
                if @sdURL {
                    downloadAndSaveVideo(@sdURL, "Đã lưu video SD vào Ảnh.")
                } else {
                    alert("TikWM không trả về video SD.", "SNVideo")
                    stop()
                }
            item "Chỉ lấy âm thanh":
                saveAudio(@audioURL, @mediaID)
            item "Hủy":
                stop()
        }
    } else {
        menu "Bạn muốn tải nội dung nào?" {
            item "Video chất lượng cao":
                if @hdURL {
                    downloadAndSaveVideo(@hdURL, "Đã lưu video HD vào Ảnh.")
                } else {
                    if @sdURL {
                        downloadAndSaveVideo(@sdURL, "Đã lưu video bằng chất lượng khả dụng.")
                    } else {
                        alert("TikWM không trả về video HD hoặc SD.", "SNVideo")
                        stop()
                    }
                }
            item "Video tải nhanh":
                if @sdURL {
                    downloadAndSaveVideo(@sdURL, "Đã lưu video SD vào Ảnh.")
                } else {
                    alert("TikWM không trả về video SD.", "SNVideo")
                    stop()
                }
            item "Hủy":
                stop()
        }
    }
}
