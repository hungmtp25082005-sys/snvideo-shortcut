// Let the user choose image labels, then download selected images one at a time.

@imageCount = count(@images)
@audioValue = getValue(@data, "music")
@mediaIDValue = getValue(@data, "id")
@audioURL = "{@audioValue}"
@mediaID = "{@mediaIDValue}"

@imageLabels: array
repeat labelIndex for @imageCount {
    @imageLabel = "Image{@labelIndex}"
    if @labelIndex < 10 {
        @imageLabel = "Image0{@labelIndex}"
    }
    @imageLabels += @imageLabel
}

@selectedImageLabels = chooseFromList(@imageLabels, "Chọn ảnh cần tải", true, true)
if !@selectedImageLabels {
    alert("Bạn chưa chọn ảnh nào.", "SNVideo")
    stop()
}

@selectedImageCount = count(@selectedImageLabels)
@selectedLabelsJoined = joinText(@selectedImageLabels, "|")
@selectedLabelSet = "|{@selectedLabelsJoined}|"
@savedCount = 0
@failedCount = 0
@imageIndex = 0

for imageItem in @images {
    @imageIndex += 1
    @imageLabel = "Image{@imageIndex}"
    if @imageIndex < 10 {
        @imageLabel = "Image0{@imageIndex}"
    }
    @imageSelectionToken = "|{@imageLabel}|"

    if @selectedLabelSet contains @imageSelectionToken {
        @imageURL = trimWhitespace("{@imageItem}")
        @validImageURL = false

        if @imageURL {
            @imageSchemeValue = getURLDetail(@imageURL, "Scheme")
            @imageHostValue = getURLDetail(@imageURL, "Host")
            @imageScheme = lowercase("{@imageSchemeValue}")
            @imageHost = lowercase("{@imageHostValue}")
            if @imageScheme == "https" && @imageHost {
                @validImageURL = true
            }
        }

        if @validImageURL == true {
            @imageFile = downloadURL(@imageURL)
            savePhoto(@imageFile)
            @savedCount += 1
        } else {
            @failedCount += 1
        }
    }
}

if @failedCount > 0 {
    showNotification("Đã lưu {@savedCount}/{@selectedImageCount} ảnh đã chọn; bỏ qua {@failedCount} URL không hợp lệ.", "SNVideo")
} else {
    showNotification("Đã lưu {@savedCount} ảnh đã chọn vào Ảnh.", "SNVideo")
}

@audioValid = false
if @audioURL {
    @audioSchemeValue = getURLDetail(@audioURL, "Scheme")
    @audioHostValue = getURLDetail(@audioURL, "Host")
    @audioScheme = lowercase("{@audioSchemeValue}")
    @audioHost = lowercase("{@audioHostValue}")
    if @audioScheme == "https" && @audioHost {
        @audioValid = true
    }
}

if @audioEnabled == true && @audioValid == true {
    menu "Bạn có muốn lưu nhạc nền?" {
        item "Lưu âm thanh":
            @shouldSaveAudio = true
        item "Không, hoàn tất":
            nothing()
    }
}
