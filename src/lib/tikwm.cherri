// TikWM request, response validation, classification, and media dispatch.

showNotification("SNVideo đang xử lý…", "SNVideo", false)
@shouldSaveAudio = false
@audioURL = ""
@mediaID = ""

// Expand only TikTok short-link hosts, then validate the redirect target.
@requestURL = "{@cleanURL}"
@shouldExpandShortURL = false
if @urlHost == "vt.tiktok.com" || @urlHost == "vm.tiktok.com" {
    @shouldExpandShortURL = true
}

if @shouldExpandShortURL == true {
    @expandedURLValue = expandURL(@cleanURL)
    @expandedURL = "{@expandedURLValue}"
    @expandedSchemeValue = getURLDetail(@expandedURL, "Scheme")
    @expandedHostValue = getURLDetail(@expandedURL, "Host")
    @expandedScheme = lowercase("{@expandedSchemeValue}")
    @expandedHost = lowercase("{@expandedHostValue}")
    @expandedHostIsTikTok = false

    if @expandedHost == "tiktok.com" {
        @expandedHostIsTikTok = true
    }
    if @expandedHost endsWith ".tiktok.com" {
        @expandedHostIsTikTok = true
    }

    if @expandedScheme != "https" || @expandedHostIsTikTok != true {
        alert("Liên kết rút gọn không chuyển hướng tới URL TikTok HTTPS hợp lệ.", "SNVideo")
        stop()
    }

    @requestURL = @expandedURL
}

// Encode the final TikTok URL exactly once before string interpolation.
@encodedURL = urlEncode(@requestURL)
@apiURL = "{TIKWM_ENDPOINT}?url={@encodedURL}&hd=1"
@rawResponse = downloadURL(@apiURL)
@response = getDictionary(@rawResponse)

if !@response {
    alert("TikWM không trả về JSON có thể đọc được.", "SNVideo")
    stop()
}

@responseCodeValue = @response['code']
@responseCode = "{@responseCodeValue}"
@responseMsgValue = @response['msg']
@responseMsg = "{@responseMsgValue}"
if @responseCode != "0" {
    alert("TikWM lỗi (code {@responseCode}): {@responseMsg}", "SNVideo")
    stop()
}

@dataValue = @response['data']
if !@dataValue {
    alert("Phản hồi TikWM thiếu trường data.", "SNVideo")
    stop()
}

@data = getDictionary(@dataValue)
if !@data {
    alert("Trường data của TikWM không phải dictionary hợp lệ.", "SNVideo")
    stop()
}

@images = @data['images']
@isSlideshow = false
if @images {
    @imageCount = count(@images)
    if @imageCount > 0 {
        @isSlideshow = true
    }
}

if @isSlideshow == true {
    #include 'lib/slideshow.cherri'
} else {
    #include 'lib/video.cherri'
}

if @shouldSaveAudio == true {
    #include 'lib/audio.cherri'
}
